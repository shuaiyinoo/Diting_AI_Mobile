{
  "name": "diting-ai-mobile",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vue-tsc -b && vite build --mode production",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:copy": "npm run build && npx cap copy",
    "cap:ios": "npx cap open ios",
    "cap:android": "npx cap open android",
    "cap:dev:ios": "npx cap run ios --livereload --external",
    "cap:dev:android": "npx cap run android --livereload --external"
  },
