# ── 后端 API（Diting_AI_Cloud，默认端口 9527）──
VITE_API_BASE_URL=http://192.168.31.81:9527

# ── STOMP 信令 ──
# ⚠️ 端点必须带角色后缀：控制端用 /ws/mobile，受控端用 /ws/desktop。
# 后端按连接的端点判定角色，连错端点会导致信令发不到对端。
# H5 开发用 ws://；页面为 https 时必须用 wss://
VITE_STOMP_URL=ws://192.168.31.81:9527/ws/mobile

# ── Coturn ──
# 局域网联调阶段【可以留空】，双方用 host candidate 直连即可，无需部署 Coturn。
# 只有跨网段 / VPN / 公网上线时才需要填，且 TURN 凭证必须由后端接口动态签发。
VITE_TURN_URL=

# ── 调试 ──
VITE_ENABLE_MOCK=false

# 手机真机通过局域网访问时，WebRTC 需要安全上下文（HTTPS）。
# 设为 true 后 npm run dev 会启用自签证书，用 https://192.168.x.x:5173 访问。
# 仅在手机浏览器直连调试时需要；用 Capacitor App 调试或电脑本地调试都不用开。
DEV_HTTPS=false